# Local-only bootstrap/admin accounts. Do not use these for service connections.
POSTGRES_ADMIN_USER=sureno_admin
POSTGRES_ADMIN_PASSWORD=change-this-local-postgres-admin-password
POSTGRES_PORT=5432

# Each PostgreSQL service account can access only its owned database.
AUTH_DB_PASSWORD=change-this-auth-password
CATALOG_DB_PASSWORD=change-this-catalog-password
ORDERS_DB_PASSWORD=change-this-orders-password
PRICES_DB_PASSWORD=change-this-prices-password
FAQ_DB_PASSWORD=change-this-faq-password

# MongoDB bootstrap account and database-scoped service accounts.
MONGO_ROOT_USERNAME=sureno_root
MONGO_ROOT_PASSWORD=change-this-local-mongo-root-password
MONGO_PORT=27017
RECOMMENDATIONS_DB_PASSWORD=change-this-recommendations-password
COCKTAILS_DB_PASSWORD=change-this-cocktails-password
